# Demo works without credentials. Change to live after running supabase/schema.sql.
APP_MODE=demo
APP_ORIGIN=http://localhost:5173
PORT=3001
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only legacy service_role key. Never use a VITE_ prefix for this key.
SUPABASE_SERVICE_ROLE_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/calendar/callback
# Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=
# TMDB API Read Access Token (bearer token, not the shorter API key)
TMDB_READ_ACCESS_TOKEN=
