# Demo works without credentials. Change to live after running supabase/schema.sql.
APP_MODE=demo
APP_ORIGIN=http://localhost:5173
PORT=3001
SUPABASE_URL=
# Shareable with the browser for Supabase Auth; access remains governed by RLS.
SUPABASE_PUBLISHABLE_KEY=
# Server-only secret key. Never expose it through frontend config or a VITE_ variable.
SUPABASE_SECRET_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/calendar/callback
# Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=
# TMDB API Read Access Token (bearer token, not the shorter API key)
TMDB_READ_ACCESS_TOKEN=
# Optional RAWG API key for online co-op game suggestions.
RAWG_API_KEY=
# TheMealDB free development key is 1; replace with a supporter key if you have one.
THEMEALDB_API_KEY=1
