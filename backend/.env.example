# Demo works without credentials. Change to live after running supabase/schema.sql.
APP_MODE=demo
APP_ORIGIN=http://localhost:8081
# Comma-separated extra web origins, including your LAN address when testing Expo Web on a phone.
APP_ALLOWED_ORIGINS=
PORT=3001
HOST=0.0.0.0
API_ORIGIN=http://localhost:3001
SUPABASE_URL=
# Client key used for Supabase Auth; access remains governed by server checks and RLS.
SUPABASE_PUBLISHABLE_KEY=
# Server-only secret key. Never expose it through frontend code or an EXPO_PUBLIC_ variable.
SUPABASE_SECRET_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/calendar/callback
# Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=
# TMDB API Read Access Token (bearer token, not the shorter API key)
TMDB_READ_ACCESS_TOKEN=
# Optional RAWG API key for online co-op game suggestions.
RAWG_API_KEY=
# TheMealDB free development key is 1; replace with a supporter key if you have one.
THEMEALDB_API_KEY=1
